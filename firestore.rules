rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).exists;
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isStudentUser() {
      return signedIn()
        && userProfileExists()
        && (
          userProfile(request.auth.uid).accountType == 'student'
          || userProfile(request.auth.uid).role == 'student'
          || userProfile(request.auth.uid).appRole == 'student'
        );
    }

    function hasStaffAccountType() {
      return signedIn()
        && userProfileExists()
        && !isStudentUser()
        && (
          userProfile(request.auth.uid).accountType in ['staff', 'teacher', 'admin']
          || userProfile(request.auth.uid).role in ['admin', 'super_admin', 'teacher', 'staff', 'manager', 'academic', 'finance', 'Admin', 'SuperAdmin', 'Teacher', 'Staff', 'Manager', 'Academic', 'Finance', 'FinanceAdmin']
          || userProfile(request.auth.uid).appRole in ['SuperAdmin', 'Admin', 'FinanceAdmin', 'TeacherAdmin', 'Staff', 'Manager', 'Academic', 'Finance', 'Teacher', 'AssistantTeacher']
        );
    }

    function isAdmin() {
      return signedIn()
        && userProfileExists()
        && hasStaffAccountType()
        && (
          userProfile(request.auth.uid).role == 'admin'
          || userProfile(request.auth.uid).appRole in ['SuperAdmin', 'Admin', 'FinanceAdmin', 'TeacherAdmin', 'Staff']
          || (userProfile(request.auth.uid).permissions is list && 'admin.full' in userProfile(request.auth.uid).permissions)
        );
    }

    function isFinance() {
      return signedIn()
        && hasStaffAccountType()
        && (
          userProfile(request.auth.uid).role in ['finance', 'Finance', 'FinanceAdmin']
          || userProfile(request.auth.uid).appRole in ['finance', 'Finance', 'FinanceAdmin']
        );
    }

    function isTeacher() {
      return signedIn()
        && userProfileExists()
        && hasStaffAccountType()
        && (
          userProfile(request.auth.uid).role == 'teacher'
          || userProfile(request.auth.uid).role == 'admin'
          || userProfile(request.auth.uid).appRole in ['SuperAdmin', 'Admin', 'FinanceAdmin', 'TeacherAdmin', 'Staff', 'Teacher', 'AssistantTeacher']
        );
    }

    function canReadCollection() {
      return signedIn() && (isAdmin() || isTeacher());
    }

    function hasAdminPermission(permissionKey) {
      return signedIn()
        && userProfileExists()
        && hasStaffAccountType()
        && userProfile(request.auth.uid).permissions is list
        && (
          permissionKey in userProfile(request.auth.uid).permissions
          || 'admin.full' in userProfile(request.auth.uid).permissions
        );
    }

    function hasMonthlyPlannerAccess() {
      return signedIn()
        && userProfileExists()
        && hasStaffAccountType()
        && (
          hasAdminPermission('admin.monthlyPlanner')
          || userProfile(request.auth.uid).role == 'admin'
          || userProfile(request.auth.uid).appRole in ['SuperAdmin', 'Admin', 'Manager', 'Academic']
        );
    }

    function protectedUserFields() {
      return [
        'uid',
        'authUid',
        'accountType',
        'role',
        'appRole',
        'permissions',
        'permissionMode',
        'status',
        'linkedStudentId',
        'linkedTeacherId',
        'studentId',
        'memberId',
        'teacherId'
      ];
    }

    function isOwnStudentProfileCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.accountType == 'student'
        && request.resource.data.role == 'student'
        && request.resource.data.appRole == 'student'
        && (!('permissions' in request.resource.data) || request.resource.data.permissions == [])
        && (!('permissionMode' in request.resource.data) || request.resource.data.permissionMode == 'student')
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    function isOwnSafeProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
    }

    function canWriteCounter() {
      return signedIn()
        && (
          isAdmin()
          || (!userProfileExists() && request.resource.data.type == 'memberId')
        );
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.authUid == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return signedIn() && request.resource.data.authUid == request.auth.uid;
    }

    function isPaymentOwner() {
      return signedIn()
        && (
          resource.data.authUid == request.auth.uid
          || resource.data.studentAuthUid == request.auth.uid
          || resource.data.slipUploadedByUid == request.auth.uid
          || resource.data.uploadedByUid == request.auth.uid
        );
    }

    function isStudentSlipUploadUpdate(docId) {
      return signedIn()
        && isPaymentOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firebaseDocId',
          'deleted',
          'slipStorageType',
          'driveFileId',
          'driveViewUrl',
          'driveFolderId',
          'driveFolderName',
          'slipUploadedByUid',
          'slipUploadedByName',
          'slipUploadedAt',
          'slipUploadedAtText',
          'slipStatus',
          'adminReviewStatus',
          'paymentStatus',
          'status',
          'updatedAt',
          'updatedBy',
          'updatedByEmail',
          'updatedByName'
        ])
        && request.resource.data.firebaseDocId == docId
        && request.resource.data.deleted == false
        && request.resource.data.slipUploadedByUid == request.auth.uid
        && request.resource.data.slipStatus == 'waiting_admin_review'
        && request.resource.data.adminReviewStatus == 'pending'
        && request.resource.data.paymentStatus == 'รอตรวจสลิป'
        && request.resource.data.status == 'รอตรวจสลิป';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || isOwnStudentProfileCreate(userId);
      allow update: if isAdmin() || isOwnSafeProfileUpdate(userId);
      allow delete: if isAdmin();
    }

    match /counters/{docId} {
      allow read: if signedIn();
      allow create, update: if canWriteCounter();
      allow delete: if isAdmin();
    }

    match /students/{docId} {
      allow read: if canReadCollection() || ownsExistingDoc();
      allow create: if isAdmin() || ownsIncomingDoc();
      allow update: if isAdmin() || (ownsExistingDoc() && ownsIncomingDoc());
      allow delete: if isAdmin();
    }

    match /payments/{docId} {
      allow read: if isAdmin() || isFinance() || isPaymentOwner() || isTeacher();
      // Payment records must be created by Admin/Finance or backend workflows only.
      // Students should not create payment documents directly.
      allow create: if isAdmin() || isFinance();
      // Apps Script uploads the file to Drive; the student client may update only slip review fields.
      // Students must not directly approve payment or change protected payment/course/receipt fields.
      allow update: if isAdmin() || isFinance() || isStudentSlipUploadUpdate(docId);
      allow delete: if isAdmin();
    }

    match /receipts/{docId} {
      allow read: if canReadCollection() || ownsExistingDoc();
      allow write: if isAdmin();
    }

    match /attendanceHistory/{docId} {
      allow read: if isAdmin() || isTeacher();
      allow write: if isAdmin() || isTeacher();
    }

    match /teachers/{docId} {
      allow read: if canReadCollection();
      allow write: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /onDemandClips/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /monthlyQuestions/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /monthlyExamLinks/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /monthlyPlans/{docId} {
      allow read: if hasMonthlyPlannerAccess() || isTeacher();
      allow create, update: if hasMonthlyPlannerAccess();
      allow delete: if false;
    }

    match /monthlyPlanSessions/{docId} {
      allow read: if hasMonthlyPlannerAccess() || isTeacher();
      allow create, update: if hasMonthlyPlannerAccess();
      allow delete: if false;
    }

    match /holidays/{docId} {
      allow read: if hasMonthlyPlannerAccess() || isTeacher();
      allow create, update: if hasMonthlyPlannerAccess();
      allow delete: if false;
    }

    match /scoreReports/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /adminScoreRecords/{docId} {
      allow read: if canReadCollection();
      allow write: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /courseTeachingSettings/{docId} {
      allow read: if canReadCollection();
      allow write: if isAdmin();
    }

    match /teacherPreferenceRules/{docId} {
      allow read: if canReadCollection();
      allow write: if isAdmin();
    }

    match /lineGroups/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /paymentMonths/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /activityLogs/{docId} {
      allow read, write: if isAdmin();
    }

    match /authCleanupQueue/{docId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
