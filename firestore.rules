rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function teacherProfileExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }

    function ownsTeacherRecord(docId) {
      return signedIn()
        && (
          docId == request.auth.uid
          || resource.data.authUid == request.auth.uid
        );
    }

    function isStudentUser() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType == 'student'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student'
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole == 'student'
        );
    }

    function hasStaffAccountType() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accountType in ['staff', 'teacher', 'admin']
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole in ['SuperAdmin', 'Admin', 'Manager', 'Academic', 'Finance', 'Viewer', 'Teacher', 'Assistant', 'TeacherAdmin', 'AssistantTeacher', 'Staff']
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'Admin', 'SuperAdmin', 'teacher', 'Teacher', 'assistant', 'Assistant', 'manager', 'Manager', 'academic', 'Academic']
        )
        || teacherProfileExists();
    }

    function isAdmin() {
      return hasStaffAccountType()
        && userProfileExists()
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.appRole in ['SuperAdmin', 'Admin']
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'SuperAdmin']
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
            && !('appRole' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          )
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions is list
            && 'admin.full' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
          )
        );
    }

    function isTeacher() {
      return signedIn()
        && hasStaffAccountType()
        && (
          teacherProfileExists()
          || (
            userProfileExists()
            && (
              userProfile(request.auth.uid).accountType == 'teacher'
              || userProfile(request.auth.uid).role == 'teacher'
              || userProfile(request.auth.uid).role == 'Teacher'
              || userProfile(request.auth.uid).role == 'assistant'
              || userProfile(request.auth.uid).role == 'Assistant'
              || userProfile(request.auth.uid).role == 'manager'
              || userProfile(request.auth.uid).role == 'Manager'
              || userProfile(request.auth.uid).role == 'academic'
              || userProfile(request.auth.uid).role == 'Academic'
              || userProfile(request.auth.uid).role == 'Admin'
              || userProfile(request.auth.uid).appRole in ['SuperAdmin', 'Admin', 'Manager', 'Academic', 'TeacherAdmin', 'Staff', 'Teacher', 'Assistant', 'AssistantTeacher']
              || hasAdminPermission('teacher.attendance')
            )
          )
        );
    }

    function hasAdminPermission(permissionKey) {
      return hasStaffAccountType()
        && userProfileExists()
        && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions is list
            && (
              permissionKey in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
              || 'admin.full' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions
            )
          )
        );
    }

    function hasAnyAdminPermission(permissionKeys) {
      return hasStaffAccountType()
        && userProfileExists()
        && (
          isAdmin()
          || (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions is list
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.hasAny(permissionKeys)
          )
        );
    }

    function isIncomingStudentUserProfile(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.authUid == userId
        && request.resource.data.accountType == 'student'
        && request.resource.data.role == 'student'
        && request.resource.data.appRole == 'student'
        && (!('permissions' in request.resource.data) || request.resource.data.permissions == [])
        && (!('permissionMode' in request.resource.data) || request.resource.data.permissionMode == 'student');
    }

    function isIncomingStaffUserProfile(userId) {
      return request.resource.data.uid == userId
        && request.resource.data.authUid == userId
        && request.resource.data.accountType in ['staff', 'teacher', 'admin']
        && request.resource.data.role in ['admin', 'teacher', 'Teacher', 'assistant', 'Assistant']
        && request.resource.data.appRole in ['Manager', 'Academic', 'Finance', 'Teacher', 'Assistant', 'Viewer', 'Staff', 'TeacherAdmin', 'AssistantTeacher']
        && request.resource.data.permissions is list
        && !request.resource.data.permissions.hasAny(['admin.full']);
    }

    function canManageStudentUserProfile(userId) {
      return hasAdminPermission('admin.students')
        && isIncomingStudentUserProfile(userId);
    }

    function canManageStaffUserProfile(userId) {
      return hasAdminPermission('admin.users')
        && isIncomingStaffUserProfile(userId)
        && (
          !exists(/databases/$(database)/documents/users/$(userId))
          || !('appRole' in get(/databases/$(database)/documents/users/$(userId)).data)
          || !(get(/databases/$(database)/documents/users/$(userId)).data.appRole in ['SuperAdmin', 'Admin'])
        )
        && (
          !exists(/databases/$(database)/documents/users/$(userId))
          || !('permissions' in get(/databases/$(database)/documents/users/$(userId)).data)
          || !(get(/databases/$(database)/documents/users/$(userId)).data.permissions is list)
          || !get(/databases/$(database)/documents/users/$(userId)).data.permissions.hasAny(['admin.full'])
        );
    }

    function canManageTeacherRecord(docId) {
      return hasAdminPermission('admin.users')
        && request.resource.data.appRole in ['Manager', 'Academic', 'Finance', 'Teacher', 'Assistant', 'Viewer', 'Staff', 'TeacherAdmin', 'AssistantTeacher']
        && (!('permissions' in request.resource.data) || (
          request.resource.data.permissions is list
          && !request.resource.data.permissions.hasAny(['admin.full'])
        ))
        && (
          !exists(/databases/$(database)/documents/teachers/$(docId))
          || !('appRole' in get(/databases/$(database)/documents/teachers/$(docId)).data)
          || !(get(/databases/$(database)/documents/teachers/$(docId)).data.appRole in ['SuperAdmin', 'Admin'])
        );
    }

    function hasMonthlyPlannerAccess() {
      return signedIn()
        && userProfileExists()
        && hasStaffAccountType()
        && (
          hasAdminPermission('admin.monthlyPlanner')
          || userProfile(request.auth.uid).appRole in ['SuperAdmin', 'Admin', 'Manager', 'Academic']
        );
    }

    function protectedUserFields() {
      return [
        'uid',
        'authUid',
        'accountType',
        'role',
        'appRole',
        'permissions',
        'permissionMode',
        'status',
        'linkedStudentId',
        'linkedTeacherId',
        'studentId',
        'memberId',
        'teacherId'
      ];
    }

    function isOwnStudentProfileCreate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.accountType == 'student'
        && request.resource.data.role == 'student'
        && request.resource.data.appRole == 'student'
        && (!('permissions' in request.resource.data) || request.resource.data.permissions == [])
        && (!('permissionMode' in request.resource.data) || request.resource.data.permissionMode == 'student')
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    function isOwnSafeProfileUpdate(userId) {
      return signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());
    }

    function canWriteCounter() {
      return signedIn()
        && (
          isAdmin()
          || (request.resource.data.type == 'memberId' && hasAdminPermission('admin.students'))
          || (request.resource.data.type == 'teacherId' && hasAdminPermission('admin.users'))
          || (!userProfileExists() && request.resource.data.type == 'memberId')
        );
    }

    function ownsExistingDoc() {
      return signedIn() && resource.data.authUid == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return signedIn() && request.resource.data.authUid == request.auth.uid;
    }

    function isLinkedStudentDocId(studentDocId) {
      return signedIn()
        && userProfileExists()
        && (
          studentDocId == request.auth.uid
          || studentDocId == userProfile(request.auth.uid).linkedStudentId
          || studentDocId == userProfile(request.auth.uid).studentDocId
          || (
            userProfile(request.auth.uid).linkedStudentIds is list
            && studentDocId in userProfile(request.auth.uid).linkedStudentIds
          )
        );
    }

    function ownsExistingGamificationDoc() {
      return signedIn()
        && isStudentUser()
        && (
          resource.data.authUid == request.auth.uid
          || isLinkedStudentDocId(resource.data.studentId)
        );
    }

    function ownsIncomingGamificationDoc() {
      return signedIn()
        && isStudentUser()
        && request.resource.data.deleted == false
        && (
          request.resource.data.authUid == request.auth.uid
          || isLinkedStudentDocId(request.resource.data.studentId)
        );
    }

    function isStudentRewardStockDecrement() {
      return signedIn()
        && isStudentUser()
        && resource.data.deleted != true
        && resource.data.active != false
        && resource.data.stock is number
        && resource.data.stock > 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock', 'updatedAt'])
        && request.resource.data.stock == resource.data.stock - 1;
    }

    function isPaymentOwner() {
      return signedIn()
        && (
          resource.data.authUid == request.auth.uid
          || resource.data.studentAuthUid == request.auth.uid
          || resource.data.slipUploadedByUid == request.auth.uid
          || resource.data.uploadedByUid == request.auth.uid
          || isLinkedStudentDocId(resource.data.studentId)
          || (
            userProfileExists()
            && (
              resource.data.memberId == userProfile(request.auth.uid).memberId
              || resource.data.memberId == userProfile(request.auth.uid).studentId
              || resource.data.studentId == userProfile(request.auth.uid).memberId
              || resource.data.studentId == userProfile(request.auth.uid).studentId
            )
          )
        );
    }

    function isIncomingPaymentOwner() {
      return signedIn()
        && (
          request.resource.data.authUid == request.auth.uid
          || request.resource.data.studentAuthUid == request.auth.uid
          || request.resource.data.slipUploadedByUid == request.auth.uid
          || isLinkedStudentDocId(request.resource.data.studentId)
          || (
            userProfileExists()
            && (
              request.resource.data.memberId == userProfile(request.auth.uid).memberId
              || request.resource.data.memberId == userProfile(request.auth.uid).studentId
              || request.resource.data.studentId == userProfile(request.auth.uid).memberId
              || request.resource.data.studentId == userProfile(request.auth.uid).studentId
            )
          )
        );
    }

    function isStudentSlipUploadUpdate(docId) {
      return signedIn()
        && isPaymentOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'id',
          'firebaseDocId',
          'deleted',
          'studentId',
          'memberId',
          'authUid',
          'studentAuthUid',
          'studentName',
          'student',
          'paymentCenter',
          'courseLocation',
          'preferredLocation',
          'slipStorageType',
          'driveFileId',
          'driveFileUrl',
          'driveViewUrl',
          'driveFolderId',
          'driveFolderName',
          'slipUploadedByUid',
          'slipUploadedByName',
          'slipUploadedAt',
          'slipUploadedAtText',
          'slipStatus',
          'adminReviewStatus',
          'paymentStatus',
          'status',
          'updatedAt',
          'updatedBy',
          'updatedByEmail',
          'updatedByName'
        ])
        && request.resource.data.firebaseDocId == docId
        && request.resource.data.deleted == false
        && isIncomingPaymentOwner()
        && request.resource.data.month != ''
        && (
          request.resource.data.driveFileId != ''
          || request.resource.data.driveFileUrl != ''
          || request.resource.data.driveViewUrl != ''
        )
        && request.resource.data.slipUploadedByUid == request.auth.uid
        && request.resource.data.slipStatus == 'waiting_admin_review'
        && request.resource.data.adminReviewStatus == 'pending'
        && request.resource.data.paymentStatus == 'รอตรวจสลิป'
        && request.resource.data.status == 'รอตรวจสลิป';
    }

    function studentSlipPaymentCreateFields() {
      return [
        'id',
        'firebaseDocId',
        'deleted',
        'studentId',
        'memberId',
        'studentName',
        'studentAuthUid',
        'authUid',
        'student',
        'courseId',
        'courseName',
        'course',
        'preferredLocation',
        'courseLocation',
        'paymentCenter',
        'month',
        'paymentMonth',
        'studentSelectedMonth',
        'baseAmount',
        'expectedAmount',
        'originalAmount',
        'discount',
        'finalAmount',
        'amount',
        'totalAmount',
        'lineItems',
        'discountType',
        'discountReason',
        'adjustedBy',
        'adjustedAtText',
        'slipUrl',
        'slipStorageType',
        'driveFileId',
        'driveFileUrl',
        'driveViewUrl',
        'driveFolderId',
        'driveFolderName',
        'slipUploadedByUid',
        'slipUploadedByName',
        'slipUploadedAt',
        'slipUploadedAtText',
        'slipStatus',
        'receiptStatus',
        'adminReviewStatus',
        'slipNote',
        'paymentStatus',
        'status',
        'createdAt',
        'createdAtText',
        'createdBy',
        'createdByEmail',
        'createdByName',
        'updatedAt',
        'updatedAtText',
        'updatedBy',
        'updatedByEmail',
        'updatedByName'
      ];
    }

    function isStudentSlipPaymentCreate(docId) {
      return signedIn()
        && isStudentUser()
        && request.resource.data.keys().hasOnly(studentSlipPaymentCreateFields())
        && request.resource.data.firebaseDocId == docId
        && request.resource.data.deleted == false
        && isIncomingPaymentOwner()
        && request.resource.data.slipUploadedByUid == request.auth.uid
        && request.resource.data.slipStatus == 'waiting_admin_review'
        && request.resource.data.adminReviewStatus == 'pending'
        && request.resource.data.paymentStatus == 'รอตรวจสลิป'
        && request.resource.data.status == 'รอตรวจสลิป'
        && !('receiptId' in request.resource.data)
        && !('receiptNo' in request.resource.data)
        && !('receiptUrl' in request.resource.data);
    }

    function isStudentPaymentBundleOwner() {
      return signedIn()
        && isStudentUser()
        && resource.data.authUid == request.auth.uid;
    }

    function isStudentPaymentBundleCreate(docId) {
      return signedIn()
        && isStudentUser()
        && request.resource.data.firebaseDocId == docId
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == 'รอชำระเงิน'
        && request.resource.data.paymentStatus == 'รอชำระเงิน';
    }

    function isStudentPaymentBundleSlipUpdate(docId) {
      return isStudentPaymentBundleOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firebaseDocId',
          'deleted',
          'slipStorageType',
          'driveFileId',
          'driveFileUrl',
          'driveViewUrl',
          'driveFolderId',
          'driveFolderName',
          'slipUploadedByUid',
          'slipUploadedByName',
          'slipUploadedAt',
          'slipUploadedAtText',
          'slipStatus',
          'adminReviewStatus',
          'paymentStatus',
          'status',
          'updatedAt',
          'updatedBy',
          'updatedByEmail',
          'updatedByName'
        ])
        && request.resource.data.firebaseDocId == docId
        && request.resource.data.deleted == false
        && request.resource.data.slipUploadedByUid == request.auth.uid
        && request.resource.data.slipStatus == 'waiting_admin_review'
        && request.resource.data.adminReviewStatus == 'pending'
        && request.resource.data.paymentStatus == 'รอตรวจสลิป'
        && request.resource.data.status == 'รอตรวจสลิป';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasStaffAccountType());
      allow create: if isAdmin()
                    || isOwnStudentProfileCreate(userId)
                    || canManageStudentUserProfile(userId)
                    || canManageStaffUserProfile(userId);
      allow update: if isAdmin()
                    || isOwnSafeProfileUpdate(userId)
                    || canManageStudentUserProfile(userId)
                    || canManageStaffUserProfile(userId);
      allow delete: if isAdmin();
    }

    match /counters/{docId} {
      allow read: if signedIn();
      allow create, update: if canWriteCounter();
      allow delete: if isAdmin();
    }

    match /students/{docId} {
      allow read: if hasStaffAccountType() || ownsExistingDoc();
      allow create: if isAdmin() || hasAdminPermission('admin.students') || ownsIncomingDoc();
      // Teacher can update attendance fields; student can update own doc but NOT attendance fields
      allow update: if isAdmin()
                    || hasAdminPermission('admin.students')
                    || isTeacher()
                    || (ownsExistingDoc() && ownsIncomingDoc()
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pickupStatus', 'pickupDate']));
      allow delete: if isAdmin();
    }

    match /payments/{docId} {
      allow read: if hasStaffAccountType() || isPaymentOwner();
      // Admin/Finance normally create payment records; students may only create
      // their own pending-review slip record when uploading for an open month.
      allow create: if isAdmin() || hasAdminPermission('admin.finance') || isStudentSlipPaymentCreate(docId);
      // Apps Script uploads the file to Drive; the student client may update only slip review fields.
      // Students must not directly approve payment or change protected payment/course/receipt fields.
      allow update: if isAdmin() || hasAdminPermission('admin.finance') || isStudentSlipUploadUpdate(docId);
      allow delete: if isAdmin();
    }

    match /paymentBundles/{docId} {
      allow read: if hasStaffAccountType() || isStudentPaymentBundleOwner();
      allow create: if isAdmin() || hasAdminPermission('admin.finance') || isStudentPaymentBundleCreate(docId);
      allow update: if isAdmin() || hasAdminPermission('admin.finance') || isStudentPaymentBundleSlipUpdate(docId);
      allow delete: if isAdmin();
    }

    match /receipts/{docId} {
      allow read: if hasStaffAccountType() || ownsExistingDoc();
      allow create, update: if hasAnyAdminPermission(['admin.receipts', 'admin.finance']);
      allow delete: if isAdmin();
    }

    match /attendanceHistory/{docId} {
      allow read: if hasStaffAccountType();
      allow write: if isAdmin() || isTeacher();
    }

    match /teachers/{docId} {
      allow read: if hasStaffAccountType() || ownsTeacherRecord(docId);
      allow create, update: if isAdmin() || canManageTeacherRecord(docId);
      allow delete: if isAdmin();
    }

    match /courses/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.courses');
      allow delete: if isAdmin();
    }

    match /onDemandClips/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.ondemand');
      allow delete: if isAdmin();
    }

    match /studentGamificationProfiles/{docId} {
      allow read: if hasStaffAccountType() || ownsExistingGamificationDoc()
                   || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, update: if hasStaffAccountType() || ownsIncomingGamificationDoc()
                   || (signedIn() && request.resource.data.authUid == request.auth.uid
                       && request.resource.data.deleted == false);
      allow delete: if isAdmin();
    }

    match /studentGamificationEvents/{docId} {
      allow read: if hasStaffAccountType() || ownsExistingGamificationDoc()
                   || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, update: if hasStaffAccountType() || ownsIncomingGamificationDoc()
                   || (signedIn() && request.resource.data.authUid == request.auth.uid
                       && request.resource.data.deleted == false);
      allow delete: if isAdmin();
    }

    match /studentPersonalQuests/{docId} {
      allow read: if hasStaffAccountType() || ownsExistingGamificationDoc()
                   || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create, update: if hasStaffAccountType();
      allow delete: if isAdmin();
    }

    match /gamificationLeaderboard/{docId} {
      allow read: if signedIn();
      allow create, update: if hasStaffAccountType()
                   || (signedIn() && request.resource.data.firebaseDocId == docId
                       && request.resource.data.deleted == false);
      allow delete: if isAdmin();
    }

    match /gamificationRewards/{docId} {
      allow read: if signedIn();
      allow create: if hasAnyAdminPermission(['admin.gamification', 'admin.prizeWheel', 'admin.settings']);
      allow update: if hasAnyAdminPermission(['admin.gamification', 'admin.prizeWheel', 'admin.settings']) || isStudentRewardStockDecrement();
      allow delete: if isAdmin();
    }

    match /gamificationRedemptions/{docId} {
      allow read: if hasStaffAccountType() || ownsExistingGamificationDoc()
                   || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create: if hasAnyAdminPermission(['admin.gamification', 'admin.prizeWheel', 'admin.settings'])
                   || hasStaffAccountType()
                   || ownsIncomingGamificationDoc()
                   || (signedIn() && request.resource.data.authUid == request.auth.uid
                       && request.resource.data.deleted == false);
      allow update: if hasAnyAdminPermission(['admin.gamification', 'admin.prizeWheel', 'admin.settings']) || hasStaffAccountType();
      allow delete: if isAdmin();
    }

    match /specialVoucherActivities/{docId} {
      allow read: if hasStaffAccountType()
                   || hasAnyAdminPermission(['admin.gamification', 'admin.settings'])
                   || (signedIn() && resource.data.deleted == false && resource.data.active == true);
      allow create, update: if hasAnyAdminPermission(['admin.gamification', 'admin.settings']);
      allow delete: if isAdmin();
    }

    match /avatarBattleQuestions/{docId} {
      allow read: if hasAnyAdminPermission(['admin.avatarBattle', 'admin.prizeWheel', 'admin.settings'])
        || (signedIn()
            && resource.data.deleted == false
            && resource.data.active == true);
      allow create, update: if hasAnyAdminPermission(['admin.avatarBattle', 'admin.prizeWheel', 'admin.settings']);
      allow delete: if isAdmin();
    }

    match /monthlyQuestions/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.exams');
      allow delete: if isAdmin();
    }

    match /monthlyExamLinks/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.exams');
      allow delete: if isAdmin();
    }

    match /monthlyPlans/{docId} {
      allow read: if hasStaffAccountType();
      allow create, update: if hasMonthlyPlannerAccess();
      allow delete: if false;
    }

    match /monthlyPlanSessions/{docId} {
      allow read: if hasStaffAccountType() || isStudentUser();
      allow create, update: if hasMonthlyPlannerAccess();
      allow delete: if false;
    }

    match /holidays/{docId} {
      allow read: if hasStaffAccountType();
      allow create, update: if hasMonthlyPlannerAccess();
      allow delete: if false;
    }

    match /scoreReports/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.exams');
      allow delete: if isAdmin();
    }

    match /adminScoreRecords/{docId} {
      allow read: if hasStaffAccountType()
                   || (isStudentUser() && resource.data.status == 'published');
      allow create, update: if hasAnyAdminPermission(['admin.exams', 'admin.onlineExams']);
      allow delete: if isAdmin();
    }

    match /announcements/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.announcements');
      allow delete: if isAdmin();
    }

    match /courseTeachingSettings/{docId} {
      allow read: if hasStaffAccountType();
      allow create, update: if hasAnyAdminPermission(['admin.courses', 'admin.monthlyPlanner']);
      allow delete: if isAdmin();
    }

    match /teacherPreferenceRules/{docId} {
      allow read: if hasStaffAccountType();
      allow create, update: if hasAnyAdminPermission(['admin.courses', 'admin.monthlyPlanner']);
      allow delete: if isAdmin();
    }

    match /lineGroups/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAnyAdminPermission(['admin.courses', 'admin.online']);
      allow delete: if isAdmin();
    }

    match /paymentMonths/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.finance');
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.settings');
      allow delete: if isAdmin();
    }

    match /activityLogs/{docId} {
      allow read: if hasAdminPermission('admin.logs');
      allow create: if hasStaffAccountType();
      allow update, delete: if isAdmin();
    }

    // ระบบวิเคราะห์คะแนน
    match /examBank/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.exams');
      allow delete: if isAdmin();
    }

    match /examResults/{docId} {
      // Admin เห็นทุกผล; นักเรียนเห็นแค่ผลของตัวเอง
      allow read: if hasAdminPermission('admin.exams') ||
                    (isStudentUser() && resource.data.studentUid == request.auth.uid);
      allow create, update: if hasAdminPermission('admin.exams');
      allow delete: if isAdmin();
    }

    match /learningMaterials/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAdminPermission('admin.online');
      allow delete: if isAdmin();
    }

    // ระบบข้อสอบออนไลน์ Interactive
    match /onlineExamCourses/{docId} {
      // Admin/staff read all; student read only published/active courses (client-side filter handles legacy flags)
      allow read: if hasAdminPermission('admin.onlineExams')
                   || (signedIn() && !isStudentUser())
                   || (isStudentUser() && (
                        resource.data.publishStatus == 'published'
                        || resource.data.status == 'active'
                      ));
      allow write: if hasAdminPermission('admin.onlineExams');
    }

    match /onlineExamResults/{docId} {
      // Admin read/write all; student read only their own results; student create only their own; student cannot update or delete
      allow read: if hasAdminPermission('admin.onlineExams')
                   || (isStudentUser() && resource.data.studentUid == request.auth.uid);
      allow create: if hasAdminPermission('admin.onlineExams')
                     || (isStudentUser()
                         && request.resource.data.studentUid == request.auth.uid
                         && request.resource.data.resultStatus == 'submitted'
                         && request.resource.data.allowRetake == false);
      allow update, delete: if hasAdminPermission('admin.onlineExams');
    }

    match /onlineExamDrafts/{docId} {
      // Student read/write/delete their own draft only; admin read all
      allow read: if hasAdminPermission('admin.onlineExams')
                   || (isStudentUser() && resource.data.studentUid == request.auth.uid);
      allow create, update: if isStudentUser()
                              && request.resource.data.studentUid == request.auth.uid;
      allow delete: if isStudentUser() && resource.data.studentUid == request.auth.uid;
    }

    match /authCleanupQueue/{docId} {
      allow read, write: if isAdmin();
    }

    match /prizeWheelItems/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAnyAdminPermission(['admin.prizeWheel', 'admin.settings']);
      allow delete: if isAdmin();
    }

    match /prizeWheelSettings/{docId} {
      allow read: if signedIn();
      allow create, update: if hasAnyAdminPermission(['admin.prizeWheel', 'admin.avatarBattle', 'admin.settings']);
      allow delete: if isAdmin();
    }

    match /prizeWheelSpins/{docId} {
      allow read: if hasStaffAccountType()
                   || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create: if signedIn()
                     && request.resource.data.authUid == request.auth.uid
                     && request.resource.data.deleted == false;
      allow update: if hasAnyAdminPermission(['admin.prizeWheel', 'admin.settings']);
      allow delete: if isAdmin();
    }

    match /expenses/{docId} {
      allow read: if hasAnyAdminPermission(['admin.finance', 'admin.expenses']);
      allow create, update: if hasAnyAdminPermission(['admin.finance', 'admin.expenses']);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
